DEBUG=True
# Django SECRET_KEY / JWT signing key — required in production (generate a long random value)
SECRET_KEY=change-me
# Fernet key used to encrypt KYC ID numbers: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# Database
DB_NAME=sunndari_db
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432

# Brevo (Email OTP)
BREVO_SMTP_LOGIN=your_brevo_smtp_login
BREVO_SMTP_KEY=your_brevo_smtp_key
DEFAULT_FROM_EMAIL=noreply@sunndari.in

# Google OAuth2
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Firebase (Admin SDK service account, for Firestore notification writes)
FIREBASE_CREDENTIALS_PATH=firebase.json

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=your_key_secret

# Public links/contact shown in the apps (optional)
TERMS_URL=
PRIVACY_URL=
CONTACT_EMAIL=
CONTACT_PHONE=

# SMS gateway (phone login/register OTP) - fill in on the server, never commit real values
SMS_GATEWAY_URL=
SMS_GATEWAY_USER=
SMS_GATEWAY_PASSWORD=
SMS_GATEWAY_SENDER_ID=
SMS_GATEWAY_ROUTE=
# Optional (defaults shown): SMS_GATEWAY_CHANNEL=Trans, SMS_GATEWAY_DCS=0, SMS_GATEWAY_FLASHSMS=0, SMS_GATEWAY_SUCCESS_CODE=000
